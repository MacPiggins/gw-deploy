# NATS server connection string
NATSCONNSTR=nats://nats:4222
NATSSTREAM=wallet

# PostgreSQL connection string/address
STORAGECONNSTR=postgres://postgres:postgres@postgres:5432/gw_wallet?sslmode=disable

# HTTP server port
SERVERADDR=:8080

# Exchange service address
EXCHANGEADDR=gw-exchanger:8080

# JWT signing secret. Replace this value outside local development.
AUTHSECRET=development-secret
